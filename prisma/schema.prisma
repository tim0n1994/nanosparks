generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id           String    @id @default(cuid())
  youtubeId    String    @unique
  title        String
  description  String?
  thumbnailUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  episodes     Episode[]

  @@index([youtubeId])
}

model Episode {
  id           String            @id @default(cuid())
  youtubeId    String            @unique
  title        String
  description  String?
  duration     Int
  thumbnailUrl String?
  channelId    String
  transcript   Json?
  status       EpisodeStatus     @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  analysis     Analysis?
  channel      Channel           @relation(fields: [channelId], references: [id])
  playlists    PlaylistEpisode[]

  @@index([channelId])
  @@index([status])
}

model Analysis {
  id           String          @id @default(cuid())
  episodeId    String          @unique
  arguments    Json
  speakers     Json
  topics       Json
  quotes       Json
  summary      Json?
  generatedAt  DateTime        @default(now())
  qualityScore Float?
  episode      Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  references   ReferenceLink[]
}

model ReferenceLink {
  id             String   @id @default(cuid())
  analysisId     String
  url            String
  title          String
  description    String?
  relevanceScore Float    @default(0)
  createdAt      DateTime @default(now())
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model Playlist {
  id          String            @id @default(cuid())
  name        String
  description String?
  userId      String
  shareId     String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  episodes    PlaylistEpisode[]

  @@index([userId])
  @@index([shareId])
}

model PlaylistEpisode {
  id         String   @id @default(cuid())
  playlistId String
  episodeId  String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, episodeId])
  @@index([playlistId])
  @@index([episodeId])
}

enum EpisodeStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
  TRANSCRIBED
}

/// Platforms supported by the resolver chain (A1). Mirrors ResolvedEpisode.platform.
enum SourcePlatform {
  xiaoyuzhou
  youtube
  apple_podcasts
  spotify
  rss
  bilibili
  direct
  generic
}

// --- Phase 0: New Domain Models ---

model Workspace {
  id        String   @id @default(cuid())
  name      String
  clerkId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  corpora   Corpus[]
  entities  Entity[]
}

model Corpus {
  id             String          @id @default(cuid())
  name           String
  description    String?
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sources        Source[]
  conversations  Conversation[]
  graphNodes     GraphNode[]
  graphEdges     GraphEdge[]
  briefs         Brief[]
  extractionRuns ExtractionRun[]
  canonicalClaims    CanonicalClaim[]
  embeddingProjections EmbeddingProjection[]

  @@index([workspaceId])
}

model Source {
  id              String          @id @default(cuid())
  kind            String // youtube_url | media_upload | transcript_upload | meeting_import
  uri             String?
  sourceType      String? // "youtube" for current pipeline
  feedUrl         String? // C3: RSS feed URL for digest-worker polling (show-level sources)
  platform        SourcePlatform? // A1: resolver platform (null for legacy sources)
  publicSlug      String?         @unique // A1/C1: public page slug /p/[slug]
  claimedByUserId String? // C4: host claim identity
  episodeId       String?         @unique // link to existing Episode
  corpusId        String
  corpus          Corpus          @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  consentStatus   String          @default("unknown")
  visibility      String          @default("private")
  retentionPolicy String          @default("keep")
  status          String          @default("pending")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  mediaAssets     MediaAsset[]
  conversations   Conversation[]

  @@index([corpusId])
  @@index([episodeId])
  @@index([platform])
}

model MediaAsset {
  id              String   @id @default(cuid())
  sourceId        String
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mediaType       String // audio | video | image | file
  storageKey      String?
  filePath        String?
  mimeType        String?
  fileSize        Int?
  retentionPolicy String?  @default("keep")
  createdAt       DateTime @default(now())

  @@index([sourceId])
}

model Conversation {
  id              String            @id @default(cuid())
  title           String?
  sourceId        String?
  source          Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  corpusId        String
  corpus          Corpus            @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  episodeId       String?           @unique // backlink to existing Episode
  episodeKey      String?           @unique // A1: global cache key platform:platformId (null for uploads)
  language        String? // A2: detected ASR language
  isSharedCache   Boolean           @default(false) // A1: part of read-only shared transcription layer
  // §3.4/§13.1: AI 访谈产物隔离 —— 合成集不混入真实播客分布，跨人对比默认排除
  isSynthetic     Boolean           @default(false)
  syntheticKind   String?           // ai_interview | ai_followup | null（真实播客）
  // §13.3 第二源：音频副语言（语速/停顿/音量/打断）—— 唯一能给情绪激活点；待音频处理填充
  audioProsodyJson Json?
  status          String            @default("pending")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  participants    Participant[]
  turns           Turn[]
  thoughtUnits    ThoughtUnit[]
  extractionRuns  ExtractionRun[]
  diarizationSegments DiarizationSegment[]
  globalEpisode   GlobalEpisode?
  readingProgress ReadingProgress[]
  highlights      Highlight[]
  publishPackages PublishPackage[]
  entityMentions  EntityMention[]

  @@index([corpusId])
  @@index([sourceId])
  @@index([episodeId])
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  role           String?
  speakerLabel   String?
  externalId     String?
  isResolved     Boolean      @default(false)
  confidence     Float?       @default(1.0)
  createdAt      DateTime     @default(now())
  turns          Turn[]
  thoughtUnits   ThoughtUnit[]
  speakerIdentities SpeakerIdentity[]

  @@index([conversationId])
}

// ── P0: L0 cross-episode speaker identity (Participant ↔ Entity) ──
// Participant is scoped to ONE conversation; Entity is the real, cross-episode
// person. SpeakerIdentity links them with a confidence and provenance signals so
// the distillation stack can ask "what did THIS person actually say?" across all
// episodes. Created by identity-resolver from name/role/voiceprint signals; rows
// with low confidence surface for human review (reviewedBy null = auto).
model SpeakerIdentity {
  id            String   @id @default(cuid())
  participantId String   @unique // §7.1: 一人一集只对应一个真实人物（关联表而非外键，错误合并可无损回滚）
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  confidence    Float    @default(0.0)
  method        String?  // §7.1: voiceprint | metadata | text | fused | manual
  signalsJson   Json?    // 兼容：{name, role, voiceprint?, metadata?}
  evidenceJson  Json?    // §7.1: {voiceCos, metaHit, textQuote, reviewerId}
  reviewedBy    String?  // null = auto-resolved; user id = human-confirmed
  reviewedAt    DateTime? // §7.1: 人工确认时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityId])
  @@index([confidence])
}

// ── I2: Diarization segments — persisted "who spoke when" timeline ──
// pyannote produces SpeakerSegment[] {label,startMs,endMs,confidence}. Previously
// discarded (diarize.ts only wrote a count into retentionPolicy), which caused the
// normalize_turns job to reverse-engineer segments from already-attributed turns —
// a bootstrap deadlock that left 98.38% of Turns with participantId = null.
// This table is the real input to speaker attribution (L1 of the distillation stack).
model DiarizationSegment {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label          String // anonymous, stable within a conversation (SPEAKER_00 ...)
  startMs        Int
  endMs          Int
  confidence     Float?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, label])
}

model Turn {
  id              String         @id @default(cuid())
  conversationId  String
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participantId   String?
  participant     Participant?   @relation(fields: [participantId], references: [id], onDelete: SetNull)
  startMs         Int
  endMs           Int
  text            String
  cleanText       String? // PII-redacted version of text
  rawText         String? // §5.5: 原始 ASR 文本（校正前），校正可回溯审计
  attributionMethod String? // §5.4: diarization | dialogue | llm | none | backfill（历史回填、出处不可考，不参与质量门）—— 让 null 可见而非静默
  attributionConfidence Float? // §5.4: 归属置信 0..1；仅真实归属运行写入，backfill 行为 null
  wordsJson       Json? // Word-level timestamps for precise evidence highlighting
  translationJson Json? // A3: language -> translated text map (bilingual reader)
  confidence      Float?         @default(1.0)
  turnIndex       Int
  createdAt       DateTime       @default(now())
  evidenceSpans   EvidenceSpan[]
  highlights      Highlight[]
  entityMentions  EntityMention[]

  @@index([conversationId])
  @@index([participantId])
}

// --- Phase 1: Thought Units ---

model ThoughtUnit {
  id                String         @id @default(cuid())
  conversationId    String
  conversation      Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type              String // claim | question | evidence | objection | decision | risk | insight
  participantId     String?        // V1: who asserted this TU (FK Participant)
  participant       Participant?   @relation(fields: [participantId], references: [id], onDelete: SetNull)
  stance            String?        // V1: assert | oppose | question | concede | neutral
  text              String
  confidence        Float          @default(1.0)
  modality          String? // asserted | quoted | paraphrased (host echoing guest = quoted)
  evidenceType      String? // experiential | data | authority | analogy | none
  polarity          Float? // -1..1 stance strength (positive = asserts)
  createdByModel    String?
  extractionVersion String?
  runId             String? // FK ExtractionRun — which run produced this TU
  run               ExtractionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  sourceAnalysisId  String? // link back to Analysis JSON for traceability
  createdAt         DateTime       @default(now())
  evidenceSpans     EvidenceSpan[]

  @@index([conversationId])
  @@index([type])
  @@index([runId])
  @@index([participantId])
}

model EvidenceSpan {
  id            String      @id @default(cuid())
  thoughtUnitId String
  thoughtUnit   ThoughtUnit @relation(fields: [thoughtUnitId], references: [id], onDelete: Cascade)
  turnId        String?
  turn          Turn?       @relation(fields: [turnId], references: [id], onDelete: SetNull)
  startMs       Int
  endMs         Int
  quote         String
  confidence    Float?      @default(1.0)

  @@index([thoughtUnitId])
  @@index([turnId])
}

// --- Phase 3: Insight Graph ---

model GraphNode {
  id            String      @id @default(cuid())
  corpusId      String
  corpus        Corpus      @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  kind          String // entity | concept | claim_cluster | topic | participant | artifact | decision | open_question
  label         String
  canonicalText String?
  metadataJson  Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  outgoingEdges GraphEdge[] @relation("source")
  incomingEdges GraphEdge[] @relation("target")
  entityId      String?     // V2: link to Entity when kind=entity

  @@index([corpusId])
  @@index([kind])
  @@index([entityId])
}

model GraphEdge {
  id           String    @id @default(cuid())
  corpusId     String
  corpus       Corpus    @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  sourceNodeId String
  sourceNode   GraphNode @relation("source", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId String
  targetNode   GraphNode @relation("target", fields: [targetNodeId], references: [id], onDelete: Cascade)
  relation     String // supports | contradicts | refines | depends_on | answers | cites | exemplifies
  confidence   Float     @default(1.0)
  evidenceJson Json? // array of { thoughtUnitId, quote, timestamp }
  createdAt    DateTime  @default(now())

  @@unique([sourceNodeId, targetNodeId, relation])
  @@index([corpusId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// --- V2: Entity layer (cross-conversation named entities) ---

model Entity {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type          String // person | org | product | book | concept | event
  canonicalName String
  aliasesJson   Json? // string[]
  embeddingId   String? // pointer into the embeddings table (resolution / star map)
  metadataJson  Json?
  disambiguationJson Json? // §8 同名人区分依据（共现网络/时间窗/声纹锚点）
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  mentions      EntityMention[]
  profile       PersonProfile?
  speakerIdentities SpeakerIdentity[]
  personClaims  PersonClaim[]
  fingerprints  PersonFingerprint[]

  @@unique([workspaceId, type, canonicalName])
  @@index([workspaceId, type])
}

model EntityMention {
  id             String       @id @default(cuid())
  entityId       String
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnId         String?
  turn           Turn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)
  surfaceForm    String
  createdAt      DateTime     @default(now())

  @@index([entityId])
  @@index([conversationId])
}

/// V2: cluster of semantically-equivalent claims across a corpus (the graph's
/// density-reduction layer — L1 shows CanonicalClaims, not raw ThoughtUnits).
model CanonicalClaim {
  id              String   @id @default(cuid())
  corpusId        String
  corpus          Corpus   @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  text            String // cluster representative sentence
  memberTuIdsJson Json // ThoughtUnit id[]
  entityIdsJson   Json? // Entity id[] the claim involves
  firstAssertedAt DateTime? // E4 time dimension
  lastAssertedAt  DateTime?
  createdAt       DateTime @default(now())

  @@index([corpusId])
}

/// V2/M3: precomputed 2D/3D projection of embeddings for the semantic star map.
/// Computed server-side (UMAP + clustering) so the frontend never runs force layout.
model EmbeddingProjection {
  id           String   @id @default(cuid())
  corpusId     String
  corpus       Corpus   @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  embeddingId  String // row in the embeddings table (thoughtUnit / quote)
  x            Float
  y            Float
  z            Float? // optional 3D star-map coordinate
  clusterId    Int?
  clusterLabel String?
  createdAt    DateTime @default(now())

  @@index([corpusId])
  @@index([corpusId, clusterId])
}

// --- V3: Person profile (aggregated from person Entities) ---

/// One row per person Entity. Aggregated cache: stats, style card, relations,
/// summary. chatEnabled is the hard gate (P-2): <3 episodes or sensitive
/// persons keep it false so persona chat stays 403.
model PersonProfile {
  id              String   @id @default(cuid())
  entityId        String   @unique
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  displayName     String
  statsJson       Json? // { showCount, episodeCount, totalMs, firstSeenAt, lastSeenAt }
  styleJson       Json? // { catchphrases[], metaphors[], sentencePatterns[], toneSummary }
  relationsJson   Json? // { coAppears:[{entityId,count}], supports:[], contradicts:[] }
  summaryText     String? // cached human-readable summary (incrementally invalidated)
  claimed         Boolean  @default(false)
  claimedByUserId String?
  chatEnabled     Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@index([claimed])
}

/// V3: per-participant speaker voiceprint (CAM++/pyannote segment embedding mean).
/// Used by cross-episode same-person resolution as a strong signal.
model SpeakerVoiceprint {
  id             String   @id @default(cuid())
  participantId   String
  embeddingJson   Json // number[]
  sampleMetaJson  Json?
  createdAt       DateTime @default(now())

  @@index([participantId])
}

// ── P2: L2 PersonClaim — a claim attributed to a specific person ──
// Distinct from CanonicalClaim (corpus-scoped semantic clusters): a PersonClaim
// answers "what does THIS person assert, and when did they start / stop?" Dual
// temporal (first/lastAssertedAt across the person's episodes) drives the stance
// timeline (P4). EvidenceSpan points back to the exact spoken turn + ms, so every
// claim is auditable against the original audio. modality=quoted excludes host
// echoing (PRD §2.3).
model PersonClaim {
  id              String   @id @default(cuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sourceThoughtUnitId String?
  text            String
  stance          String   // assert | oppose | question | concede | neutral
  modality        String?  // asserted | quoted | paraphrased
  evidenceType    String?
  polarity        Float?
  firstAssertedAt DateTime?
  lastAssertedAt  DateTime?
  // §7.3 双时态（借 Zep/Graphiti）：valid time + system time，失效而非删除
  ingestedAt      DateTime @default(now()) // system time：我们何时知道的
  supersededById  String?  // 被哪条后续陈述取代（失效而非删除）
  supersededAt    DateTime? // 失效时间
  canonicalId     String?  // §7.3: 归并到哪个 CanonicalClaim（主题归一）
  createdAt       DateTime @default(now())

  @@index([entityId])
  @@index([sourceThoughtUnitId])
  @@index([canonicalId])
}

// ── P3: L3 PersonFingerprint — versioned distillation of a person ──
// Aggregates L1 (own turns) + L2 (PersonClaims) into a "thought fingerprint":
// core claims, stance map, style (evidence-type distribution / hedging / concession),
// citation lineage, signature analogies, and stance changes. Versioned — each
// rebuild writes a new row (the previous fingerprint is itself auditable, per PRD §8).
// Every array entry in *Json carries citations[] back to a turn+ms, never shown bare.
model PersonFingerprint {
  id             String   @id @default(cuid())
  entityId       String
  entity         Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  version        Int
  coreClaimsJson Json     // [{claimId, text, recurrence, citations[]}]
  stanceMapJson  Json     // {topic: {position, drift, citations[]}}
  styleJson      Json     // {evidenceTypeDist, hedgeRate, concessionRate, sourceTypes[]}
  lineageJson    Json     // [{entityId/name, count}] — who they repeatedly cite
  analogiesJson  Json     // [{sourceDomain, vehicle, citation}]
  changesJson    Json     // [{claimId, before, after, citations[]}] stance flips
  coverageJson   Json     // {episodeCount, wordCount, timeSpanMs}
  builtAt        DateTime @default(now())

  @@unique([entityId, version])
  @@index([entityId])
}

// --- LLM Settings ---

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// --- ExtractionRun (replayable extraction/embedding/graph runs) ---

model ExtractionRun {
  id             String        @id @default(cuid())
  corpusId       String?
  corpus         Corpus?       @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String // extract | embed | graph
  model          String
  promptVersion  String?
  params         Json?
  status         String        @default("pending") // pending | running | completed | failed
  costUsd        Float?        @default(0)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  isActive       Boolean       @default(false)
  thoughtUnits   ThoughtUnit[]

  @@index([corpusId])
  @@index([conversationId])
  @@index([kind])
  @@index([isActive])
}

// --- Brief (synthesis layer — one-pager with citations) ---

model Brief {
  id           String   @id @default(cuid())
  corpusId     String
  corpus       Corpus   @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  title        String
  sectionsJson Json
  sourceRunId  String?
  shareId      String?  @unique
  visibility   String   @default("private")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([corpusId])
}

// --- AuditLog (governance — view/export/share/delete/settings events) ---

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String?
  actorId      String?
  action       String // view | export | share | delete | settings_change
  resourceType String
  resourceId   String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([workspaceId])
  @@index([action])
  @@index([resourceType, resourceId])
}

// --- A1: Global Transcription Cache (shared read-only layer) ---

/// One row per canonical episode across all users. episodeKey = `${platform}:${platformId}`.
/// Public-source conversations become shared cache; uploads never create a GlobalEpisode.
model GlobalEpisode {
  id              String         @id @default(cuid())
  episodeKey      String         @unique // platform:platformId
  platform        SourcePlatform
  platformId      String
  conversationId  String         @unique // the canonical shared Conversation (1:1)
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title           String
  showTitle       String?
  coverUrl        String?
  durationSec     Int?
  sourceUrl       String? // original submitted URL (copyright backlink)
  audioUrl        String? // A3: enclosure/platform audio URL for the inline player (PRD: 播原始 enclosure)
  description     String? // episode description — entity context for fact-correction pass
  readCount       Int            @default(0)
  firstIngestedAt DateTime       @default(now())
  lastPolledAt    DateTime? // C3: when the digest worker last polled this show's feed
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([platform])
  @@index([readCount])
}

// --- A3: Reading Progress (per-user resume-read hook) ---

model ReadingProgress {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnIndex      Int          @default(0)
  scrollRatio    Float? // 0..1 completion (>=0.7 counts as finished-read)
  completedAt    DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([userId, conversationId])
  @@index([conversationId])
}

// --- B1: Publish Package (一鱼多吃 content generator output) ---

/// One generated content package per (conversation, platform, variant).
/// variant = 金句版/清单版/争议观点版 (PRD §B1).
model PublishPackage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  briefId        String?
  userId         String
  platform       String // xiaohongshu | wechat | zhihu
  variant        String // quote | list | controversy | digest
  copyText       String // generated copy (title + body + tags)
  assetsJson     Json? // { cards: [{type, pngStorageKey}], cover?: storageKey }
  status         String       @default("draft") // draft | exported | published
  publishedUrl   String?
  sensitiveHits  Int          @default(0) // B1: count of sensitive-word hits for UI highlight
  costUsd        Float?       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, platform, variant])
  @@index([userId])
  @@index([platform])
}

// --- C2: Highlight (single-person value loop) ---

model Highlight {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnId         String?
  turn           Turn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)
  startOffset    Int          @default(0)
  endOffset      Int          @default(0)
  note           String?
  visibility     String       @default("private") // private | public
  createdAt      DateTime     @default(now())

  collectionItems CollectionItem[]

  @@index([userId])
  @@index([conversationId])
  @@index([turnId])
}

// --- C2: Collection (cross-podcast topical sets) ---

model Collection {
  id          String           @id @default(cuid())
  userId      String
  title       String
  description String?
  visibility  String           @default("private")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  highlightId  String
  highlight    Highlight  @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, highlightId])
  @@index([collectionId])
}

// --- C3: Follow (show + topic subscriptions -> digest) ---

model Follow {
  id         String   @id @default(cuid())
  userId     String
  targetType String // source | topic
  targetId   String // sourceId or topic label
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

// --- A3/§2.3: Notification (站内红点 — processing complete / new episode) ---

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // processing_complete | new_episode | digest
  title     String
  body      String?
  linkUrl   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
