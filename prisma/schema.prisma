generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id           String    @id @default(cuid())
  youtubeId    String    @unique
  title        String
  description  String?
  thumbnailUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  episodes     Episode[]

  @@index([youtubeId])
}

model Episode {
  id           String            @id @default(cuid())
  youtubeId    String            @unique
  title        String
  description  String?
  duration     Int
  thumbnailUrl String?
  channelId    String
  transcript   Json?
  status       EpisodeStatus     @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  analysis     Analysis?
  channel      Channel           @relation(fields: [channelId], references: [id])
  playlists    PlaylistEpisode[]

  @@index([channelId])
  @@index([status])
}

model Analysis {
  id           String          @id @default(cuid())
  episodeId    String          @unique
  arguments    Json
  speakers     Json
  topics       Json
  quotes       Json
  summary      Json?
  generatedAt  DateTime        @default(now())
  qualityScore Float?
  episode      Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  references   ReferenceLink[]
}

model ReferenceLink {
  id             String   @id @default(cuid())
  analysisId     String
  url            String
  title          String
  description    String?
  relevanceScore Float    @default(0)
  createdAt      DateTime @default(now())
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model Playlist {
  id          String            @id @default(cuid())
  name        String
  description String?
  userId      String
  shareId     String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  episodes    PlaylistEpisode[]

  @@index([userId])
  @@index([shareId])
}

model PlaylistEpisode {
  id         String   @id @default(cuid())
  playlistId String
  episodeId  String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, episodeId])
  @@index([playlistId])
  @@index([episodeId])
}

enum EpisodeStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
  TRANSCRIBED
}

// --- Phase 0: New Domain Models ---

model Workspace {
  id        String   @id @default(cuid())
  name      String
  clerkId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  corpora   Corpus[]
}

model Corpus {
  id             String          @id @default(cuid())
  name           String
  description    String?
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sources        Source[]
  conversations  Conversation[]
  graphNodes     GraphNode[]
  graphEdges     GraphEdge[]
  briefs         Brief[]
  extractionRuns ExtractionRun[]

  @@index([workspaceId])
}

model Source {
  id              String       @id @default(cuid())
  kind            String       // youtube_url | media_upload | transcript_upload | meeting_import
  uri             String?
  sourceType      String?      // "youtube" for current pipeline
  episodeId       String?      @unique // link to existing Episode
  corpusId        String
  corpus          Corpus       @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  consentStatus   String       @default("unknown")
  visibility      String       @default("private")
  retentionPolicy String       @default("keep")
  status          String       @default("pending")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  mediaAssets     MediaAsset[]
  conversations   Conversation[]

  @@index([corpusId])
  @@index([episodeId])
}

model MediaAsset {
  id              String   @id @default(cuid())
  sourceId        String
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mediaType       String   // audio | video | image | file
  storageKey      String?
  filePath        String?
  mimeType        String?
  fileSize        Int?
  retentionPolicy String?  @default("keep")
  createdAt       DateTime @default(now())

  @@index([sourceId])
}

model Conversation {
  id          String        @id @default(cuid())
  title       String?
  sourceId    String?
  source      Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  corpusId    String
  corpus      Corpus        @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  episodeId   String?       @unique // backlink to existing Episode
  status      String        @default("pending")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  participants Participant[]
  turns       Turn[]
  thoughtUnits ThoughtUnit[]
  extractionRuns ExtractionRun[]

  @@index([corpusId])
  @@index([sourceId])
  @@index([episodeId])
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  role           String?
  speakerLabel   String?
  externalId     String?
  isResolved     Boolean      @default(false)
  confidence     Float?       @default(1.0)
  createdAt      DateTime     @default(now())
  turns          Turn[]

  @@index([conversationId])
}

model Turn {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participantId  String?
  participant    Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  startMs        Int
  endMs          Int
  text           String
  cleanText      String?      // PII-redacted version of text
  wordsJson      Json?        // Word-level timestamps for precise evidence highlighting
  confidence     Float?       @default(1.0)
  turnIndex      Int
  createdAt      DateTime     @default(now())
  evidenceSpans  EvidenceSpan[]

  @@index([conversationId])
  @@index([participantId])
}

// --- Phase 1: Thought Units ---

model ThoughtUnit {
  id                String         @id @default(cuid())
  conversationId    String
  conversation      Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type              String         // claim | question | evidence | objection | decision | risk | insight
  text              String
  confidence        Float          @default(1.0)
  createdByModel    String?
  extractionVersion String?
  runId             String?        // FK ExtractionRun — which run produced this TU
  run               ExtractionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  sourceAnalysisId  String?        // link back to Analysis JSON for traceability
  createdAt         DateTime       @default(now())
  evidenceSpans     EvidenceSpan[]

  @@index([conversationId])
  @@index([type])
  @@index([runId])
}

model EvidenceSpan {
  id            String      @id @default(cuid())
  thoughtUnitId String
  thoughtUnit   ThoughtUnit @relation(fields: [thoughtUnitId], references: [id], onDelete: Cascade)
  turnId        String?
  turn          Turn?       @relation(fields: [turnId], references: [id], onDelete: SetNull)
  startMs       Int
  endMs         Int
  quote         String
  confidence    Float?      @default(1.0)

  @@index([thoughtUnitId])
  @@index([turnId])
}

// --- Phase 3: Insight Graph ---

model GraphNode {
  id            String     @id @default(cuid())
  corpusId      String
  corpus        Corpus     @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  kind          String     // entity | concept | claim_cluster | topic | participant | artifact | decision | open_question
  label         String
  canonicalText String?
  metadataJson  Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  outgoingEdges GraphEdge[] @relation("source")
  incomingEdges GraphEdge[] @relation("target")

  @@index([corpusId])
  @@index([kind])
}

model GraphEdge {
  id            String   @id @default(cuid())
  corpusId      String
  corpus        Corpus   @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  sourceNodeId  String
  sourceNode    GraphNode @relation("source", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId  String
  targetNode    GraphNode @relation("target", fields: [targetNodeId], references: [id], onDelete: Cascade)
  relation      String   // supports | contradicts | refines | depends_on | answers | cites | exemplifies
  confidence    Float    @default(1.0)
  evidenceJson  Json?    // array of { thoughtUnitId, quote, timestamp }
  createdAt     DateTime @default(now())

  @@index([corpusId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@unique([sourceNodeId, targetNodeId, relation])
}

// --- LLM Settings ---

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// --- ExtractionRun (replayable extraction/embedding/graph runs) ---

model ExtractionRun {
  id             String   @id @default(cuid())
  corpusId       String?
  corpus         Corpus?  @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String   // extract | embed | graph
  model          String
  promptVersion  String?
  params         Json?
  status         String   @default("pending") // pending | running | completed | failed
  costUsd        Float?   @default(0)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  isActive       Boolean  @default(false)
  thoughtUnits   ThoughtUnit[]

  @@index([corpusId])
  @@index([conversationId])
  @@index([kind])
  @@index([isActive])
}

// --- Brief (synthesis layer — one-pager with citations) ---

model Brief {
  id            String   @id @default(cuid())
  corpusId      String
  corpus        Corpus   @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  title         String
  sectionsJson  Json
  sourceRunId   String?
  shareId       String?  @unique
  visibility    String   @default("private")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([corpusId])
}

// --- AuditLog (governance — view/export/share/delete/settings events) ---

model AuditLog {
  id             String   @id @default(cuid())
  workspaceId    String?
  actorId        String?
  action         String   // view | export | share | delete | settings_change
  resourceType   String
  resourceId     String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  @@index([workspaceId])
  @@index([action])
  @@index([resourceType, resourceId])
}
