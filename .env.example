# Database
DATABASE_URL=postgresql://nanosparks:nanosparks@localhost:15158/nanosparks

# Redis (BullMQ)
REDIS_URL=redis://localhost:16688

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM API (OpenAI or compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth (Clerk) — REQUIRED in production. Leave empty for local dev (auth is
# skipped via isValidClerkKey). In production, the worker refuses to start
# and middleware refuses to serve protected routes without valid keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Whisper
WHISPER_MODEL_SIZE=base

# ── Local whisper.cpp (A2 R3) — practical local ASR without GPU/API ──
WHISPER_CPP_PATH=/Users/chillbit/Proj/podcast-intel/whisper.cpp/build/bin/whisper-cli
# WHISPER_CPP_MODEL=/Users/chillbit/Proj/podcast-intel/whisper.cpp/models/ggml-large-v3-turbo.bin

# ── ASR providers (A2 language routing) ──
# Alibaba Bailian (DashScope) — Chinese default (Paraformer paraformer-v2).
# Native word-level timestamps + speaker_id + diarization in one async call.
BAILIAN_API_KEY=
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
BAILIAN_ASR_MODEL=paraformer-v2

# Deepgram — English default.
DEEPGRAM_API_KEY=

# Optional: force an ASR provider regardless of language (paraformer|deepgram).
# ASR_PROVIDER_OVERRIDE=paraformer

# ── Resolver cookies (A1) — for sources needing login (B站充电/YouTube age gate) ──
# Path to a Netscape cookies file, or a raw cookie header. Leave empty otherwise.
# RESOLVER_COOKIES=

# ── SEO主动推送 (C1) — 百度站长 + Google Search Console ──
# NEXT_PUBLIC_SITE_URL=https://nanosparks.example  (公开页 base，用于 sitemap + 主动推送)
# BAIDU_PUSH_SITE=nanosparks.example  (百度站长已验证站点)
# BAIDU_PUSH_TOKEN=your_baidu_token
# GOOGLE_INDEXING_TOKEN=your_google_indexing_api_token  (服务账号 OAuth2 access token)

# ── Production guardrails (A4) ──
# Per-user concurrent processing jobs, daily ingest cap, audio duration ceiling (sec),
# and per-episode cost circuit breaker (CNY).
# GUARD_MAX_CONCURRENT=1
# GUARD_MAX_DAILY=5
# GUARD_MAX_DURATION_SEC=14400
# GUARD_COST_BREAKER_CNY=3

# Embeddings (OpenAI) — used for semantic search via pgvector
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# PII Redaction
# M0: uses built-in regex patterns (no additional config needed)

# Object Storage (MinIO/S3)
# STORAGE_PROVIDER=local  (default) or s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=nanosparks
# S3_ACCESS_KEY=nanosparks
# S3_SECRET_KEY=nanosparks123
# S3_REGION=us-east-1
# S3_PUBLIC_URL=http://localhost:9000  (for generating public URLs)

# ── Card rendering fonts (B1) ──
# Path to a CJK-capable TTF for satori. Production: 思源黑体/霞鹜文楷 (OFL).
# SATORI_FONT_PATH=/app/fonts/NotoSansSC-Regular.otf

# Secrets Encryption (AES-256-GCM)
# Required in production — generate with: openssl rand -hex 32
# ENCRYPTION_MASTER_KEY=

# Pyannote Diarization
# HF_TOKEN=your_huggingface_token  (needed for pyannote community-1 model)

# Optional: Sentry / monitoring
# SENTRY_DSN=
