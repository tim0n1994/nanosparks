# Database
DATABASE_URL=postgresql://nanosparks:nanosparks@localhost:5432/nanosparks

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM API (OpenAI or compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth (Clerk) — leave empty or use placeholder for local dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Whisper
WHISPER_MODEL_SIZE=base

# Embeddings (OpenAI) — used for semantic search via pgvector
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# PII Redaction
# M0: uses built-in regex patterns (no additional config needed)

# Object Storage (MinIO/S3)
# STORAGE_PROVIDER=local  (default) or s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=nanosparks
# S3_ACCESS_KEY=nanosparks
# S3_SECRET_KEY=nanosparks123
# S3_REGION=us-east-1
# S3_PUBLIC_URL=http://localhost:9000  (for generating public URLs)

# Secrets Encryption (AES-256-GCM)
# Required in production — generate with: openssl rand -hex 32
# ENCRYPTION_MASTER_KEY=

# Pyannote Diarization
# HF_TOKEN=your_huggingface_token  (needed for pyannote community-1 model)

# Optional: Sentry / monitoring
# SENTRY_DSN=
