# Database
DATABASE_URL=postgresql://nanosparks:nanosparks@localhost:5432/nanosparks

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM API (OpenAI or compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth (Clerk) — leave empty or use placeholder for local dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Whisper
WHISPER_MODEL_SIZE=base

# Embeddings (OpenAI) — used for semantic search via pgvector
# text-embedding-3-small (default, 512 dims) is recommended for M0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# PII Redaction
# M0: uses built-in regex patterns (no additional config needed)
# M1: PRESIDIO_ANALYZER_URL=http://presidio-analyzer:5000
# PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:5000

# Optional: Sentry / monitoring
# SENTRY_DSN=
