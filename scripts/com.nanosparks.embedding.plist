<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nanosparks.embedding</string>
	<key>WorkingDirectory</key>
	<string><personal-home>/Proj/nanosparks</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/llama-server</string>
		<string>-m</string>
		<string><personal-home>/models/bge-m3/bge-m3-q8_0.gguf</string>
		<string>--embedding</string>
		<string>--pooling</string>
		<string>mean</string>
		<string>--ctx-size</string>
		<string>8192</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8080</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/chillbit</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleStartInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string><personal-home>/Library/Logs/nanosparks/embedding.out.log</string>
	<key>StandardErrorPath</key>
	<string><personal-home>/Library/Logs/nanosparks/embedding.err.log</string>
</dict>
</plist>
